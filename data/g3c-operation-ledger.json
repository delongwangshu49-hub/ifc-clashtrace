      "title": "Pipe surface touches wall surface",
      "structure_entity_type": "IfcWall",
      "hard_clash_status": "CLEAR",
      "geometry_reliable": true,
      "coordinate_system_consistent": true,
      "structure": {"kind": "box", "center_world_m": [0.0, 0.0, 0.0], "half_extents_m": [2.0, 0.1, 1.5], "rotation_deg_xyz": [0.0, 0.0, 0.0]},
      "pipe": {"geometry_present": true, "radius_m": 0.05, "axis_start_structure_local_m": [-1.0, 0.15, 0.0], "axis_end_structure_local_m": [1.0, 0.15, 0.0]},
      "expected_record": {"emitted": true, "status": "WARNING", "clearance_distance_m": 0.0}
    },
    {
      "case_id": "G3C02",
      "title": "Pipe has 49 mm wall clearance",
