{
  "dataset_id": "IFC_CLASHTRACE_G3C_CLEARANCE_V1",
  "version": "1.0.0",
  "rule_id": "MEP_STRUCTURE_CLEARANCE_WARNING_V1",
  "license_spdx_or_name": "CC0-1.0",
  "length_unit": "metre",
  "coordinate_system": "shared_project_coordinates",
  "threshold_m": 0.05,
  "comparison": "WARNING when certified minimum surface clearance is greater than or equal to zero and strictly less than threshold_m; equality is CLEAR",
